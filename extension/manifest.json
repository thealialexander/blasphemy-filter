{
  "manifest_version": 3,
  "name": "NO BLASPHEMY",
  "version": "1.8.1",
  "description": "Obscures common blasphemy and irreverent exclamations, with an offline text checker.",
  "icons": {
    "16": "icons/cross-16.png",
    "32": "icons/cross-32.png",
    "48": "icons/cross-48.png",
    "128": "icons/cross-128.png"
  },
  "action": {
    "default_title": "NO BLASPHEMY",
    "default_icon": {
      "16": "icons/cross-16.png",
      "32": "icons/cross-32.png"
    },
    "default_popup": "checker.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["matcher.js", "mask.js", "custom-phrases.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["shadow-roots.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
